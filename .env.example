# Variables de entorno del proyecto en Vercel (Settings → Environment Variables)

# Token de la API de Vercel: Account Settings → Tokens → Create, con alcance al equipo que quieres controlar.
VERCEL_TOKEN=

# Contraseña para entrar en la app desde el móvil (16 caracteres aleatorios o más).
APP_PASSWORD=

# ID de tu equipo (empieza por «team_»; opcional si el token ya apunta a él).
VERCEL_TEAM_ID=

# Nombre de este proyecto, para que nunca se pause a sí mismo (por defecto: vercel-pausa).
SELF_PROJECT_NAME=vercel-pausa
